# One Console API key for every adapter
ANTHROPIC_API_KEY=
# Exact model string, expanded into specs/claude-baseline.yaml and logged verbatim.
# claude-haiku-5-5 for smoke runs (~$0.10/MTok in), claude-sonnet-5-5 for the matrix.
MODEL=claude-sonnet-5-5
# AgentDojo knobs (defaults shown)
HM_DOJO_VERSION=v1.2.2
HM_DOJO_ATTACK=important_instructions
HM_DOJO_MAX_TASKS=20
# Postgres for `hm load` (matches docker-compose.yml)
HM_PG_DSN=postgresql://hm:hm@localhost:5434/hm
